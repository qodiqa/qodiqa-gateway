{
  "name": "@qodiqa/sdk",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for QODIQA AI enforcement platform — the maintained JS/TS SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "qodiqa",
    "ai",
    "enforcement",
    "verification",
    "artifact",
    "attestation",
    "transparency",
    "audit",
    "sdk",
    "typescript"
  ],
  "author": "QODIQA",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/qodiqa/sdk-js"
  },
  "homepage": "https://github.com/qodiqa/qodiqa-gateway/tree/main/sdk/javascript",
  "bugs": {
    "url": "https://github.com/qodiqa/sdk-js/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-json-stable-stringify": "^2.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@typescript-eslint/parser": "8.44.0",
    "eslint": "8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
