{
  "//": "Minimal typecheck for the gateway (JS checked with checkJs). It covers the cryptographic/validation core; extending it to all of src/ is later work.",
  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "strict": false, "noImplicitAny": false, "skipLibCheck": true, "types": ["node"], "maxNodeModuleJsDepth": 0, "resolveJsonModule": true
  },
  "include": ["src/validation/**/*.js", "services/artifact/**/*.js", "src/infra/crypto/**/*.js", "src/utils/**/*.js"],
  "exclude": ["**/__tests__/**", "**/*.test.js", "node_modules"]
}
