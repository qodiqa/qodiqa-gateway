          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(qodiqa_audit_disk_full_total[5m]))",
          "legendFormat": "disk full",
          "refId": "C",
          "range": true
        }
      ]
    },
