# QODIQA — file + Postgres DR JSON export.
# Self-hosted equivalent of deploy/kubernetes/base/backup-cronjobs.yaml's
# qodiqa-dr-backup CronJob. Unlike the Kubernetes form (a separate pod that
# cannot reach per-pod audit-log volumes), a self-hosted single-instance
# deployment runs on the SAME host as the live QODIQA process, so
# QODIQA_AUDIT_LOG / QODIQA_KEYS_PATH / QODIQA_POLICY_STORE in
# backup.env should point at the SAME paths the running server uses — every
# file-based component (audit chain, key store, policy store) is captured
# here, not just the Postgres-backed and key-store subset the Kubernetes
# CronJob is scoped to. See docs/operations/backup-scheduling.md.
[Unit]
Description=QODIQA file + PostgreSQL DR backup
Wants=network-online.target
After=network-online.target postgresql.service qodiqa.service

[Service]
Type=oneshot
User=qodiqa
Group=qodiqa
WorkingDirectory=/opt/qodiqa
EnvironmentFile=/etc/qodiqa/backup.env
Environment=QODIQA_BACKUP_METRICS_FILE=/var/backups/qodiqa-dr/metrics/qodiqa_dr_backup.prom
ExecStart=/opt/qodiqa/deploy/systemd/dr-backup-run.sh
TimeoutStartSec=1200

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/qodiqa-dr
CapabilityBoundingSet=
# further sandboxing — none of these affects what the unit legitimately does
# (TCP/Unix sockets to PostgreSQL, files under ReadWritePaths). Check with `systemd-analyze security <unit>`.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
