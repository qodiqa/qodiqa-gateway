# QODIQA — WAL-archive staleness/integrity verification.
# Self-hosted equivalent of deploy/kubernetes/base/backup-cronjobs.yaml's qodiqa-pg-backup-verify-wal CronJob,
# which existed only for Kubernetes: without it a self-hosted deployment never proved the WAL-archive RPO.
# Non-destructive: checks that the newest archived segment is younger than QODIQA_WAL_ARCHIVE_MAX_AGE_SECONDS
# and that its seal verifies (scripts/pg-wal-archive.sh --verify). The PostgreSQL server's archive_command must
# write into QODIQA_WAL_ARCHIVE_DIR (backup.env) — see docs/operations/backup-runbook.md.
[Unit]
Description=QODIQA PostgreSQL WAL-archive verification
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=qodiqa
Group=qodiqa
EnvironmentFile=/etc/qodiqa/backup.env
ExecStart=/opt/qodiqa/scripts/pg-wal-archive.sh --verify
TimeoutStartSec=180

# ReadWritePaths must match QODIQA_WAL_ARCHIVE_DIR's parent in backup.env (see qodiqa-pg-backup-daily.service).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/qodiqa
CapabilityBoundingSet=
# further sandboxing — none of these affects what the unit legitimately does
# (TCP/Unix sockets to PostgreSQL, files under ReadWritePaths). Check with `systemd-analyze security <unit>`.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
