# QODIQA — scheduled restore validation. Backs up,
# restores into an isolated scratch directory + isolated
# QODIQA_PG_RESTORE_URL database (never the live one — see scripts/dr/
# restore.js and scripts/dr/postgres.js, both of which refuse to touch a
# non-empty target / the live connection string), then validates via the
# real production modules (audit-log.js, policyStore.js, keyStore.js).
# On a self-hosted single-instance deployment running on the same host as
# the live server, every file-based component (audit chain, key store,
# policy store) is fully reachable and validated — unlike the Kubernetes
# CronJob form, which is scoped to the Postgres-backed state only. See
# docs/operations/backup-scheduling.md.
[Unit]
Description=QODIQA DR restore validation
Wants=network-online.target
After=network-online.target postgresql.service qodiqa.service

[Service]
Type=oneshot
User=qodiqa
Group=qodiqa
WorkingDirectory=/opt/qodiqa
EnvironmentFile=/etc/qodiqa/backup.env
Environment=DR_CYCLE_DIR=/var/backups/qodiqa-dr/restore-validation-scratch
Environment=QODIQA_BACKUP_METRICS_FILE=/var/backups/qodiqa-dr/metrics/qodiqa_dr_restore_validation.prom
ExecStart=/usr/bin/env node /opt/qodiqa/scripts/dr/cycle.js
TimeoutStartSec=1800

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/qodiqa-dr
CapabilityBoundingSet=
# this was the only unit without a private /tmp (DR_CYCLE_DIR is under /var/backups, not /tmp)
PrivateTmp=yes
# further sandboxing — none of these affects what the unit legitimately does
# (TCP/Unix sockets to PostgreSQL, files under ReadWritePaths). Check with `systemd-analyze security <unit>`.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
