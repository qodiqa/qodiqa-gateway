# QODIQA — audit-chain file backup verification.
# Non-destructive: seal check, gzip integrity, non-empty-content check, and
# a staleness check that fails closed if the newest backup is older than
# QODIQA_AUDIT_BACKUP_MAX_AGE_SECONDS (default 600s) — the signal that the
# 5-minute schedule has actually kept running, not just that it was set up.
[Unit]
Description=QODIQA audit-chain file backup verification
Wants=network-online.target
After=network-online.target qodiqa-audit-log-backup.service

[Service]
Type=oneshot
User=qodiqa
Group=qodiqa
EnvironmentFile=/etc/qodiqa/backup.env
ExecStart=/opt/qodiqa/scripts/backup-audit-log.sh verify
TimeoutStartSec=120

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/qodiqa
CapabilityBoundingSet=
# further sandboxing — none of these affects what the unit legitimately does
# (TCP/Unix sockets to PostgreSQL, files under ReadWritePaths). Check with `systemd-analyze security <unit>`.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
