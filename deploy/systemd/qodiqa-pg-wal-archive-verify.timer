# QODIQA — WAL-archive verification schedule: every 5 minutes, the same cadence
# as the Kubernetes qodiqa-pg-backup-verify-wal CronJob and archive_timeout — see that CronJob's comment for why it
# is a separate, cheap check rather than part of qodiqa-pg-backup-verify.
[Unit]
Description=Run QODIQA WAL-archive verification every 5 minutes

[Timer]
OnCalendar=*:0/5
Persistent=true
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
