# QODIQA — incremental PostgreSQL WAL-streaming backup.
# Requires wal_level=replica, archive_mode=on, and REPLICATION privilege for
# the backup role — see scripts/pg-backup.sh's run_incremental_backup().
[Unit]
Description=QODIQA PostgreSQL incremental (WAL streaming) backup
# pg-backup.sh incremental is UNSUPPORTED (exit 2, BACKUP_INCREMENTAL_UNSUPPORTED) until the
# owner grants REPLICATION to the backup role. Until then this unit must not run on its 6-hourly timer and
# produce a failing/ambiguous run: it starts only if the operator has created the enabling file AFTER granting REPLICATION.
ConditionPathExists=/etc/qodiqa/enable-incremental-backup
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=qodiqa
Group=qodiqa
EnvironmentFile=/etc/qodiqa/backup.env
ExecStart=/opt/qodiqa/scripts/pg-backup.sh incremental
TimeoutStartSec=1800

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/qodiqa
CapabilityBoundingSet=
# further sandboxing — none of these affects what the unit legitimately does
# (TCP/Unix sockets to PostgreSQL, files under ReadWritePaths). Check with `systemd-analyze security <unit>`.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
