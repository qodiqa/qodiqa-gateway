# QODIQA — PostgreSQL backup verification. Non-destructive:
# integrity seal check, pg_restore --list, and full-table-coverage check
# against the latest daily-tier backup. Scheduled 30 minutes after
# qodiqa-pg-backup-daily.service, not concurrently.
[Unit]
Description=QODIQA PostgreSQL backup verification (daily tier)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=qodiqa
Group=qodiqa
EnvironmentFile=/etc/qodiqa/backup.env
ExecStart=/opt/qodiqa/scripts/pg-backup.sh verify daily
TimeoutStartSec=900

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/qodiqa
CapabilityBoundingSet=
# further sandboxing — none of these affects what the unit legitimately does
# (TCP/Unix sockets to PostgreSQL, files under ReadWritePaths). Check with `systemd-analyze security <unit>`.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
