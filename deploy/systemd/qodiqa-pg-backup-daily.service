# QODIQA — daily PostgreSQL full backup.
# Self-hosted / bare-metal equivalent of
# deploy/kubernetes/base/backup-cronjobs.yaml's qodiqa-pg-backup-daily CronJob —
# same script, same tier, same configuration file. See
# docs/operations/backup-scheduling.md for the full setup (creating
# /etc/qodiqa/backup.env, the qodiqa system user, and directory permissions).
[Unit]
Description=QODIQA PostgreSQL full backup (daily tier)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=qodiqa
Group=qodiqa
EnvironmentFile=/etc/qodiqa/backup.env
ExecStart=/opt/qodiqa/scripts/pg-backup.sh full daily
TimeoutStartSec=3600

# Hardening — this unit only needs to read PostgreSQL over the network and
# write to its own backup directory; everything else is locked down.
# NOTE: ReadWritePaths cannot reference the EnvironmentFile's
# $QODIQA_BACKUP_DIR (systemd directives are not shell-expanded against
# EnvironmentFile — that file only populates the service PROCESS's
# environment). This must match QODIQA_BACKUP_DIR in backup.env exactly; the
# default below matches scripts/pg-backup.sh's own default. Update both
# together if you change it.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/qodiqa
CapabilityBoundingSet=
# further sandboxing — none of these affects what the unit legitimately does
# (TCP/Unix sockets to PostgreSQL, files under ReadWritePaths). Check with `systemd-analyze security <unit>`.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
