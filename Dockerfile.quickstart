# Image of the local evaluation sandbox (docker-compose.quickstart.yml). Dependencies are installed while the image is built,
# so starting the sandbox does not install anything. Not a production image: see Dockerfile.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
EXPOSE 3000
CMD ["node", "bin/qodiqa.js", "dev", "--port", "3000", "--redis-url", "redis://redis:6379", "--no-docker-redis", "--no-docker-pg"]
